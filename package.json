{
  "name": "modgud-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "bun test packages",
    "verify": "bun run check && bun run test",
    "build": "bun run --cwd packages/modgud loom build --out ../../dist/modgud"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "vite-plus": "^1.0.0"
  }
}
